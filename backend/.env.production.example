APP_NAME="Sistema de Entregas"
APP_ENV=production
APP_KEY=base64:Mb19MbPJAv37Hqhyu/qBQ1Uarxzk5bfl0u8KJyIgEuU=
APP_DEBUG=false
APP_URL=http://localhost

# Deixe comentado em produção offline para que o Sanctum aceite qualquer IP da rede local automaticamente via currentRequestHost()
# SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=*

APP_OPERATION_TIMEZONE=America/Fortaleza

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# ==============================================================================
# BANCO DO SISTEMA DE ENTREGAS (POSTGRESQL NO DOCKER)
# -> NÃO PRECISA MEXER AQUI (já bate com o docker-compose.prod.yml)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sistema_entregas
DB_USERNAME=entregas_user
DB_PASSWORD=entregas_prod_2026

# ==============================================================================
# INTEGRAÇÃO COM O BANCO DA LOJA (FIREBIRD - SOMENTE LEITURA)
# -> ÚNICO LUGAR ONDE VOCÊ VAI MEXER AO CHEGAR NO PC WINDOWS DA LOJA
#
# Como ajustar na loja:
# 1. FIREBIRD_HOST: mantenha "host.docker.internal" (faz o Docker enxergar o Windows).
# 2. FIREBIRD_PORT: confira a porta do Firebird da loja (padrão é 3050).
# 3. FIREBIRD_DATABASE: coloque o caminho real do arquivo .fdb no Windows da loja
#    (use barra normal "/" em vez de "\", ex.: C:/SistemaLoja/Dados/LOJA.FDB).
# 4. FIREBIRD_USERNAME / PASSWORD: só mude se a loja não usar o padrão SYSDBA/masterkey.
# ==============================================================================
FIREBIRD_HOST=host.docker.internal
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:/Caminho/Real/Da/Loja/LOJA.FDB
FIREBIRD_USERNAME=SYSDBA
FIREBIRD_PASSWORD=masterkey
FIREBIRD_CHARSET=WIN1252

# ==============================================================================
# SESSÃO, CACHE E FILAS (OFFLINE / LOCAL)
# -> NÃO PRECISA MEXER AQUI
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sistema@loja.local"
MAIL_FROM_NAME="${APP_NAME}"